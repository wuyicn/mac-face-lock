{
  "mode": "presence_guard",
  "camera_index": 0,
  "verify_window_seconds": 4.0,
  "frame_interval_seconds": 0.35,
  "owner_pass_threshold": 2,
  "stranger_lock_threshold": 3,
  "no_face_lock_threshold": 7,
  "idle_seconds_before_armed": 60,
  "active_state_update_interval_seconds": 10,
  "system_idle_poll_enabled": true,
  "system_idle_trigger_seconds": 2.0,
  "cooldown_seconds_after_pass": 5,
  "cooldown_seconds_after_lock": 300,
  "lock_on_camera_error": false,
  "camera_error_cooldown_seconds": 300,
  "lock_on_unknown_when_armed": true,
  "capture_camera_on_lock": true,
  "capture_screen_on_lock": false,
  "event_notify_on_lock": false,
  "event_notify_title": "Mac 非本人使用提醒",
  "event_notify_level": "critical",
  "event_notify_source": "mac-face-lock-agent",
  "event_notify_script": "",
  "event_notify_timeout_seconds": 10,
  "use_profile_face_detector": true,
  "face_match_threshold": 0.72,
  "allow_owner_from_final_evidence": true,
  "final_evidence_owner_threshold": 0.82,
  "enroll_samples": 16,
  "enroll_timeout_seconds": 40,
  "log_level": "info"
}
